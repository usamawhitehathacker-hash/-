{%- comment -%}
  Header Section (Premium Rebuild)
  ---------------------------------
  Central header section -- Logo + Navigation + Actions.
  Ties together all Phase A-H premium header features.

  Connected files:
    - snippets/header-styles.liquid (CSS variables)
    - snippets/header-row.liquid (row composition)
    - snippets/header-actions.liquid (cart/search/account/wishlist)
    - snippets/header-drawer.liquid -> header-mobile-drawer-premium.liquid (mobile)
    - blocks/_header-logo.liquid (logo with inverse + shrink)
    - blocks/_header-menu.liquid (mega menu with 5 layouts + badges)
    - assets/header-premium.js (sticky/transparent/shrink controller)

  Premium features:
    - 4 logo positions (left/center/right/split)
    - 3 sticky modes (always/scroll-up/shrink)
    - Transparent header (per-template via theme settings)
    - Mega menu (5 layouts via _header-menu block)
    - Full-screen search overlay
    - Premium mobile drawer
    - Customizer control (20+ settings)
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign color_scheme = s.color_scheme | default: 'scheme-1'
  assign logo_position = s.logo_position | default: 'left'
  assign menu_handle = s.menu | default: 'main-menu'
  assign menu = linklists[menu_handle]
  assign header_height = s.header_height | default: 80
  assign container_width = s.container_width | default: 'default'
  assign menu_alignment = s.menu_alignment | default: 'center'

  # Transparent header detection (from theme settings)
  assign template_name = template.name | default: 'index'
  assign is_transparent = false
  if template_name == 'index' and settings.header_transparent_on_home
    assign is_transparent = true
  elsif template_name == 'collection' and settings.header_transparent_on_collection
    assign is_transparent = true
  elsif template_name == 'product' and settings.header_transparent_on_product
    assign is_transparent = true
  elsif template_name == 'page' and settings.header_transparent_on_page
    assign is_transparent = true
  endif

  assign sticky_behavior = settings.header_sticky_behavior | default: 'shrink'
-%}

{%- render 'header-styles', section: section -%}

<header
  class="header-premium header-premium--logo-{{ logo_position }} color-{{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="header-premium"
  data-sticky-behavior="{{ sticky_behavior }}"
  data-is-transparent="{{ is_transparent }}"
  {{ section.shopify_attributes }}
>
  <div class="header-premium__inner" style="--header-height: {{ header_height }}px;">
    <div class="header-premium__container header-premium__container--{{ container_width }}">

      {%- comment -%} Mobile menu trigger (hamburger) {%- endcomment -%}
      <button
        type="button"
        class="header-premium__menu-trigger header-premium__mobile-only"
        aria-label="{{ 'header.navigation.open_menu' | t }}"
        aria-expanded="false"
        aria-controls="DrawerPremium"
        data-drawer-open
      >
        <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M2 4h12M2 8h12M2 12h12"/>
        </svg>
      </button>

      {%- comment -%} Logo block {%- endcomment -%}
      <div class="header-premium__logo-area">
        {%- for block in section.blocks -%}
          {%- if block.type == '_header-logo' -%}
            {%- render block -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Navigation (desktop) {%- endcomment -%}
      <nav class="header-premium__nav header-premium__desktop-only" aria-label="{{ 'header.navigation.primary' | t }}">
        {%- for block in section.blocks -%}
          {%- if block.type == '_header-menu' -%}
            {%- render block -%}
          {%- endif -%}
        {%- endfor -%}
      </nav>

      {%- comment -%} Header actions (search, account, wishlist, cart) {%- endcomment -%}
      <div class="header-premium__actions">
        {%- render 'header-actions' -%}
      </div>

    </div>
  </div>

  {%- comment -%} Mega menu overlay backdrop {%- endcomment -%}
  {%- if settings.header_mega_menu_overlay -%}
    <div class="header-premium__mega-overlay" data-mega-overlay hidden aria-hidden="true"></div>
  {%- endif -%}
</header>

{%- comment -%} Mobile drawer (rendered outside header for z-index stacking) {%- endcomment -%}
{%- render 'header-drawer', linklist: menu, section: section -%}

{% stylesheet %}
  .header-premium {
    position: relative;
    background: var(--header-background, rgb(var(--color-background)));
    border-bottom: var(--header-border-width, 0) solid var(--header-border-color, rgba(0,0,0,0.08));
    z-index: 50;
    transition: background var(--header-animation-duration, 250ms) var(--header-easing, ease),
                transform var(--header-animation-duration, 250ms) var(--header-easing, ease);
  }

  .header-premium__inner {
    min-height: var(--header-height, 80px);
    display: flex;
    align-items: center;
    padding-top: var(--header-padding-top, 16px);
    padding-bottom: var(--header-padding-bottom, 16px);
  }

  .header-premium__container {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    max-width: var(--header-container-max, 1440px);
    margin: 0 auto;
    padding: 0 var(--page-gutter, 1.5rem);
  }

  .header-premium__container--wide { max-width: 1600px; }
  .header-premium__container--full { max-width: 100%; }
  .header-premium__container--narrow { max-width: 1140px; }

  /* Logo positions */
  .header-premium--logo-left .header-premium__container {
    grid-template-columns: auto 1fr auto;
  }
  .header-premium--logo-center .header-premium__container {
    grid-template-columns: 1fr auto 1fr;
  }
  .header-premium--logo-center .header-premium__logo-area {
    order: 2;
    justify-self: center;
  }
  .header-premium--logo-center .header-premium__nav {
    order: 1;
    justify-self: start;
  }
  .header-premium--logo-center .header-premium__actions {
    order: 3;
    justify-self: end;
  }
  .header-premium--logo-right .header-premium__container {
    grid-template-columns: 1fr auto auto;
  }
  .header-premium--logo-right .header-premium__logo-area {
    order: 3;
  }
  .header-premium--logo-right .header-premium__nav {
    order: 1;
  }
  .header-premium--logo-right .header-premium__actions {
    order: 2;
  }

  /* Desktop/Mobile visibility */
  .header-premium__desktop-only {
    display: none;
  }
  .header-premium__mobile-only {
    display: flex;
  }
  @media (min-width: 990px) {
    .header-premium__desktop-only { display: flex; }
    .header-premium__mobile-only { display: none; }
  }

  /* Menu trigger (hamburger) */
  .header-premium__menu-trigger {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: inherit;
    line-height: 0;
  }

  /* Mega menu overlay */
  .header-premium__mega-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 40;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--header-animation-duration, 250ms) ease;
  }
  .header-premium__mega-overlay[data-visible] {
    opacity: 1;
    pointer-events: auto;
  }

  /* Navigation */
  .header-premium__nav {
    align-items: center;
    justify-content: var(--header-menu-alignment, center);
  }

  /* Actions */
  .header-premium__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: end;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header (Premium)",
  "tag": "div",
  "class": "section-header-premium",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height",
      "min": 60,
      "max": 160,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "default", "label": "Default" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "menu_alignment",
      "label": "Menu alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "menu_spacing",
      "label": "Menu item spacing",
      "min": 16,
      "max": 56,
      "step": 4,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_custom_background",
      "label": "Use custom background color",
      "default": false
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#E5E5E5"
    }
  ],
  "blocks": [
    {
      "type": "_header-logo",
      "name": "Logo",
      "limit": 1
    },
    {
      "type": "_header-menu",
      "name": "Navigation menu",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Header (Premium)",
      "blocks": [
        { "type": "_header-logo" },
        { "type": "_header-menu" }
      ]
    }
  ]
}
{% endschema %}
