{%- comment -%} Premium mega menu typography {%- endcomment -%}
.mega-menu-column__heading {
  font-weight: 600;
  font-size: 0.875rem;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  margin-bottom: 0.75rem;
  color: inherit;
}

.mega-menu-column__heading--link:hover {
  text-decoration: underline;
}

.mega-menu-column__link {
  font-size: 0.8125rem;
  line-height: 1.4;
  padding: 0.25rem 0;
  color: inherit;
  opacity: 0.8;
  transition: opacity 150ms ease;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.mega-menu-column__link:hover {
  opacity: 1;
}

.mega-menu-column__link--active {
  opacity: 1;
  font-weight: 500;
}

.mega-menu-column__view-all {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.8125rem;
  font-weight: 500;
  margin-top: 0.75rem;
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.mega-menu-column__view-all:hover {
  text-decoration-thickness: 2px;
}

.mega-menu-banner__heading {
  font-weight: 700;
  font-size: 1.125rem;
  line-height: 1.2;
}

.mega-menu-banner__subheading {
  font-size: 0.75rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  opacity: 0.8;
}

.mega-menu-product__title {
  font-size: 0.8125rem;
  font-weight: 500;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mega-menu-product__vendor {
  font-size: 0.6875rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  opacity: 0.6;
}

.mega-menu-product__price {
  font-size: 0.8125rem;
}

.mega-menu-product__price--sale {
  color: var(--color-sale, #cc0000);
  font-weight: 600;
}

.mega-menu-product__price--compare {
  opacity: 0.5;
  font-size: 0.75rem;
}

.mega-menu-promo__heading {
  font-weight: 600;
  font-size: 0.875rem;
}

.mega-menu-promo__subheading {
  font-size: 0.8125rem;
  opacity: 0.8;
}

.mega-menu-promo__button {
  font-size: 0.75rem;
  font-weight: 500;
  text-decoration: underline;
  text-underline-offset: 2px;
}
