{%- comment -%}
  Mega menu promo callout block (PUBLIC)
  ---------------------------------------
  Compact promotional callout inside mega menu (icon + heading + text + CTA).
  Ideal for: shipping offers, new arrivals callouts, discount codes, free returns.

  Used by: blocks/_header-menu.liquid (Step 23)
  Pattern: Symmetry / Impulse / Broadcast — in-menu promo callouts

  Settings:
    - icon (select)
    - heading (text)
    - subheading (text)
    - button_label (text)
    - button_url (url)
    - layout (select): horizontal | vertical
    - use_custom_colors (checkbox)
    - bg_color (color)
    - text_color (color)
{%- endcomment -%}

{%- liquid
  assign s = block.settings
  assign icon = s.icon | default: 'none'
  assign heading = s.heading | default: ''
  assign subheading = s.subheading | default: ''
  assign button_label = s.button_label | default: ''
  assign button_url = s.button_url
  assign layout = s.layout | default: 'horizontal'
  assign use_custom_colors = s.use_custom_colors | default: false
  assign bg_color = s.bg_color
  assign text_color = s.text_color
-%}

{%- capture inline_style -%}
  {%- if use_custom_colors -%}
    --promo-bg: {{ bg_color }}; --promo-text: {{ text_color }};
  {%- endif -%}
{%- endcapture -%}

<div
  class="mega-menu-promo mega-menu-promo--{{ layout }}{% if use_custom_colors %} mega-menu-promo--custom-colors{% endif %}"
  {% if inline_style != blank %}style="{{ inline_style | strip_newlines | strip }}"{% endif %}
  {{ block.shopify_attributes }}
>
  {%- if icon != 'none' -%}
    <span class="mega-menu-promo__icon" aria-hidden="true">
      {%- case icon -%}
        {%- when 'truck' -%}
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="6" width="13" height="10" rx="1"/><path d="M15 9h4l3 3v4h-7"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
        {%- when 'gift' -%}
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="9" width="18" height="12" rx="1"/><path d="M3 13h18M12 9v12M8 9c-3 0-3-5 0-5s4 5 4 5-1-5 0-5 4 0 4 5"/></svg>
        {%- when 'percent' -%}
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><path d="m20 4-16 16"/></svg>
        {%- when 'star' -%}
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 2l3 7 7 .8-5.5 4.7 1.3 7L12 18l-5.8 3.5L7.5 14.5 2 9.8 9 9z"/></svg>
        {%- when 'fire' -%}
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 2s-3 4-3 7 1.5 4 3 4 3-1.5 3-4-3-7-3-7zm-4 9c-1.5 1.5-3 3-3 6 0 3 3 5 7 5s7-2 7-5c0-3-1.5-4.5-3-6 0 1.5-1 3-1.5 3 0-1.5-1.5-3-3-4.5 0 4.5-3 6-4.5 6z"/></svg>
        {%- when 'tag' -%}
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2H3v9l11 11 9-9-11-11z"/><circle cx="7" cy="6" r="1.2" fill="currentColor"/></svg>
        {%- when 'return' -%}
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
        {%- when 'shield' -%}
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2 4 5v6c0 5 3 9 8 11 5-2 8-6 8-11V5l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>
      {%- endcase -%}
    </span>
  {%- endif -%}

  <div class="mega-menu-promo__content">
    {%- if heading != blank -%}
      <p class="mega-menu-promo__heading">{{ heading | escape }}</p>
    {%- endif -%}

    {%- if subheading != blank -%}
      <p class="mega-menu-promo__subheading">{{ subheading | escape }}</p>
    {%- endif -%}

    {%- if button_label != blank -%}
      <a
        class="mega-menu-promo__button"
        {% if button_url != blank %}href="{{ button_url }}"{% else %}href="#" aria-disabled="true"{% endif %}
      >
        {{ button_label | escape }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:premium_header.names.mega_menu_promo",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none",    "label": "t:premium_header.options.icon_none" },
        { "value": "truck",   "label": "Truck (shipping)" },
        { "value": "gift",    "label": "Gift" },
        { "value": "percent", "label": "Percent (discount)" },
        { "value": "star",    "label": "Star" },
        { "value": "fire",    "label": "Fire (hot)" },
        { "value": "tag",     "label": "Tag (offer)" },
        { "value": "return",  "label": "Return (free returns)" },
        { "value": "shield",  "label": "Shield (secure)" }
      ],
      "default": "truck"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Free shipping"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "On orders over $50"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "horizontal", "label": "Horizontal (icon left)" },
        { "value": "vertical",   "label": "Vertical (icon top)" }
      ],
      "default": "horizontal"
    },
    {
      "type": "header",
      "content": "t:premium_header.groups.colors"
    },
    {
      "type": "checkbox",
      "id": "use_custom_colors",
      "label": "t:premium_header.settings.use_custom_colors",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ]
}
{% endschema %}
