{%- comment -%}
  Mega menu image banner block (PUBLIC)
  --------------------------------------
  Promotional image banner with overlay text + button inside mega menu.
  Best for: featured collection drops, seasonal campaigns, lookbook entries.

  Used by: blocks/_header-menu.liquid (Step 23)
  Pattern: Prestige Layout 3/5 (image-feature column)

  Settings:
    - image (image_picker)
    - heading (text)
    - subheading (text)
    - button_label (text)
    - button_url (url)
    - overlay_opacity (range)
    - text_color (color) + use_custom_text_color (checkbox)
    - alignment (select)
{%- endcomment -%}

{%- liquid
  assign s = block.settings
  assign image = s.image
  assign heading = s.heading | default: ''
  assign subheading = s.subheading | default: ''
  assign button_label = s.button_label | default: ''
  assign button_url = s.button_url
  assign overlay_opacity = s.overlay_opacity | default: 30
  assign use_custom_text_color = s.use_custom_text_color | default: false
  assign text_color = s.text_color
  assign alignment = s.alignment | default: 'bottom-left'

  assign overlay_alpha = overlay_opacity | divided_by: 100.0

  assign tag = 'div'
  if button_url != blank and button_label == blank
    assign tag = 'a'
  endif
-%}


<{{ tag }}
  class="mega-menu-banner mega-menu-banner--align-{{ alignment }}{% if image == blank %} mega-menu-banner--no-image{% endif %}"
  {% if tag == 'a' %}href="{{ button_url }}"{% endif %}
  style="--overlay-alpha: {{ overlay_alpha }};{% if use_custom_text_color %} --banner-text: {{ text_color }};{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if image != blank -%}
    <div class="mega-menu-banner__image">
      {{
        image
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          alt: image.alt | default: heading | escape,
          width: image.width,
          height: image.height,
          sizes: '(min-width: 990px) 33vw, 100vw',
          widths: '300, 600, 900, 1200',
          class: 'mega-menu-banner__image-img'
      }}
      {%- if overlay_opacity > 0 -%}
        <span class="mega-menu-banner__overlay" aria-hidden="true"></span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if heading != blank or subheading != blank or button_label != blank -%}
    <div class="mega-menu-banner__content">
      {%- if subheading != blank -%}
        <p class="mega-menu-banner__subheading">{{ subheading | escape }}</p>
      {%- endif -%}

      {%- if heading != blank -%}
        <p class="mega-menu-banner__heading">{{ heading | escape }}</p>
      {%- endif -%}

      {%- if button_label != blank -%}
        <a
          class="mega-menu-banner__button button button--primary button--small"
          {% if button_url != blank %}href="{{ button_url }}"{% else %}href="#" aria-disabled="true"{% endif %}
        >
          {{ button_label | escape }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</{{ tag }}>

{% schema %}
{
  "name": "t:premium_header.names.mega_menu_image_banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:premium_header.settings.image_banner_image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:premium_header.settings.image_banner_heading",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:premium_header.settings.image_banner_subheading",
      "default": "Spring 2026"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:premium_header.settings.image_banner_button_label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:premium_header.settings.image_banner_button_link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text position",
      "options": [
        { "value": "top-left",      "label": "Top left" },
        { "value": "top-center",    "label": "Top center" },
        { "value": "top-right",     "label": "Top right" },
        { "value": "middle-left",   "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right",  "label": "Middle right" },
        { "value": "bottom-left",   "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right",  "label": "Bottom right" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:premium_header.settings.image_banner_overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:premium_header.groups.colors"
    },
    {
      "type": "checkbox",
      "id": "use_custom_text_color",
      "label": "Use custom text color",
      "default": false
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
