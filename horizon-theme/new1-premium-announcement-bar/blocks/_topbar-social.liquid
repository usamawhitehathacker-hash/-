{%- comment -%}
  Top bar social icon block (PRIVATE)
  -----------------------------------
  Single social media icon for the top bar.
  Merchant adds one block per platform.

  Used by: sections/header-topbar.liquid
  Pattern: Symmetry / Stiletto / Enterprise top contact bar

  Settings:
    - platform (select): facebook | instagram | twitter | tiktok | youtube | pinterest | linkedin | whatsapp
    - url (url): Profile URL
{%- endcomment -%}

{%- liquid
  assign platform = block.settings.platform | default: 'instagram'
  assign url = block.settings.url
-%}

{%- if url != blank -%}
  <a
    class="topbar-social topbar-social--{{ platform }}"
    href="{{ url }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ platform | capitalize }}"
    {{ block.shopify_attributes }}
  >
    <span class="visually-hidden">{{ platform | capitalize }}</span>
    {%- case platform -%}
      {%- when 'facebook' -%}
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M9.5 16v-7h2.3l.3-2.7H9.5v-1.7c0-.8.2-1.3 1.3-1.3H12V0L10.4 0C8.3 0 7 1.3 7 3.6V6.3H4.7V9H7v7h2.5z"/></svg>
      {%- when 'instagram' -%}
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="2" y="2" width="12" height="12" rx="3.5"/><circle cx="8" cy="8" r="3"/><circle cx="11.5" cy="4.5" r="0.6" fill="currentColor"/></svg>
      {%- when 'twitter' -%}
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12.5 2h2L9.7 7.5 15.4 14h-4.4L7.7 9.6 3.9 14h-2L7.1 8.1 1.6 2h4.5l3 3.9L12.5 2zm-.7 10.7h1.1L4.4 3.2H3.2l8.6 9.5z"/></svg>
      {%- when 'tiktok' -%}
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M11.6 2c.4 1.3 1.3 2.3 2.6 2.5v2.3c-1 0-2-.4-2.7-1v4.4a3.7 3.7 0 1 1-3.7-3.7v2.3a1.4 1.4 0 1 0 1.4 1.4V2h2.4z"/></svg>
      {%- when 'youtube' -%}
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M14.7 4.5c-.2-.7-.7-1.2-1.4-1.4C12 2.7 8 2.7 8 2.7s-4 0-5.3.4c-.7.2-1.2.7-1.4 1.4C1 5.8 1 8 1 8s0 2.2.3 3.5c.2.7.7 1.2 1.4 1.4 1.3.4 5.3.4 5.3.4s4 0 5.3-.4c.7-.2 1.2-.7 1.4-1.4.3-1.3.3-3.5.3-3.5s0-2.2-.3-3.5zM6.5 10.5V5.5L10.7 8l-4.2 2.5z"/></svg>
      {%- when 'pinterest' -%}
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 1a7 7 0 0 0-2.5 13.5c0-.5-.1-1.4 0-1.9.1-.5.7-3 .7-3s-.2-.4-.2-1c0-.9.5-1.6 1.2-1.6.6 0 .9.4.9 1 0 .6-.4 1.5-.6 2.3-.2.7.4 1.3 1 1.3 1.3 0 2.2-1.6 2.2-3.5 0-1.5-1-2.5-2.4-2.5-1.6 0-2.6 1.2-2.6 2.5 0 .5.2 1 .4 1.3l.1.3-.2.7c0 .2-.1.2-.3.1-1-.4-1.5-1.7-1.5-2.7 0-2.2 1.6-4.2 4.5-4.2 2.4 0 4.2 1.7 4.2 4 0 2.3-1.5 4.2-3.5 4.2-.7 0-1.3-.4-1.5-.8l-.4 1.5c-.1.6-.5 1.3-.8 1.7A7 7 0 1 0 8 1z"/></svg>
      {%- when 'linkedin' -%}
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M3.5 6h2v8h-2v-8zm1-3.3a1.2 1.2 0 1 1 0 2.5 1.2 1.2 0 0 1 0-2.5zM7 6h2v1.1c.3-.5.9-1.3 2.2-1.3 2.4 0 2.8 1.6 2.8 3.6V14h-2v-4c0-1 0-2.2-1.3-2.2s-1.5 1-1.5 2.1V14H7V6z"/></svg>
      {%- when 'whatsapp' -%}
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 1.5C4.4 1.5 1.5 4.4 1.5 8c0 1.2.3 2.3.9 3.3L1.5 14.5l3.3-.9c1 .5 2 .8 3.2.8 3.6 0 6.5-2.9 6.5-6.5S11.6 1.5 8 1.5zm3.7 9.2c-.2.4-.9.8-1.3.9-.3 0-.7.1-2.4-.5-2-.8-3.3-2.9-3.4-3-.1-.1-.8-1.1-.8-2.1 0-1 .5-1.5.7-1.7.2-.2.4-.2.6-.2h.4c.1 0 .3 0 .4.4l.7 1.6c.1.1 0 .3 0 .4l-.3.4c-.1.1-.2.2-.1.4 0 .2.4 1 .9 1.5.6.6 1.2.8 1.4.9.2.1.3.1.4 0l.6-.6c.1-.1.2-.1.4-.1l1.5.7c.1.1.2.1.3.2 0 .1 0 .4-.1.6z"/></svg>
    {%- endcase -%}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "t:premium_header.names.topbar_social",
  "settings": [
    {
      "type": "select",
      "id": "platform",
      "label": "t:premium_header.settings.social_platform",
      "options": [
        { "value": "facebook",  "label": "t:premium_header.options.platform_facebook" },
        { "value": "instagram", "label": "t:premium_header.options.platform_instagram" },
        { "value": "twitter",   "label": "t:premium_header.options.platform_twitter" },
        { "value": "tiktok",    "label": "t:premium_header.options.platform_tiktok" },
        { "value": "youtube",   "label": "t:premium_header.options.platform_youtube" },
        { "value": "pinterest", "label": "t:premium_header.options.platform_pinterest" },
        { "value": "linkedin",  "label": "t:premium_header.options.platform_linkedin" },
        { "value": "whatsapp",  "label": "t:premium_header.options.platform_whatsapp" }
      ],
      "default": "instagram"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:premium_header.settings.social_url"
    }
  ]
}
{% endschema %}
